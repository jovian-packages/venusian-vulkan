{
    "name": "jovian/venusian-vulkan",
    "description": "The 'vulkan' rendering engine for Venusian Surface: a GpuDevice over ext-vulkan that draws Surface's draw lists on V3DV, MoltenVK or any Vulkan 1.1+ GPU and presents into a surface a canvas lends.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "vulkan",
        "moltenvk"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-vulkan/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-vulkan/issues",
        "source": "https://github.com/jovian-packages/venusian-vulkan"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-vulkan": "^0.11.0",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-surface/drawing": "^0.11.0",
        "venusian-surface/framebuffers": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-surface/fonts": "^0.11.0"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\Vulkan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\Vulkan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\Vulkan\\Providers\\VenusianVulkanServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "ext-metal": "On macOS, presenting into a canvas's CAMetalLayer goes through vkCreateMetalSurfaceEXT over ext-metal's layer."
    }
}
