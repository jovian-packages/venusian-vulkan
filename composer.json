{
    "name": "jovian/venusian-vulkan",
    "description": "The 'vulkan' graphics engine for Venusian Topside: a device, framebuffer and rasterizer over ext-vulkan, on MoltenVK or any Vulkan GPU with host image copies.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "vulkan",
        "moltenvk"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-vulkan/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-vulkan/issues",
        "source": "https://github.com/jovian-packages/venusian-vulkan"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-vulkan": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\Vulkan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\Vulkan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\Vulkan\\Providers\\VenusianVulkanServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "ext-metal": "On macOS, presenting into a canvas's CAMetalLayer goes through vkCreateMetalSurfaceEXT over ext-metal's layer."
    }
}
